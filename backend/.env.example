# Скопируйте в .env и при необходимости заполните. Без ключей всё работает на детерминированном движке.

# --- LLM (необязательно) ---
# auto | openai | gemini | off
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Любой OpenAI-совместимый сервер (например, локальный или прокси)
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Таймаут LLM в секундах (фронт ждёт ИИ-эндпоинты 15 с)
LLM_TIMEOUT=10

# --- Данные ---
# Засеять БД 12 демо-кандидатами при первом старте
SEED_DEMO_DATA=true
# Показывать демо-данные в списках/аналитике по умолчанию (?include_demo=false — скрыть)
SHOW_DEMO_DATA=true
# DATABASE_URL=sqlite:///./ochakovo.db

# --- ВКонтакте (необязательно: без токена бот работает в режиме симуляции) ---
# Ключ доступа сообщества (Управление → Работа с API → Ключи доступа): права «сообщения сообщества», «управление»
VK_GROUP_TOKEN=
# id сообщества (число без минуса); если пусто — определяется по токену
VK_GROUP_ID=
# Ссылка на мини-приложение, например https://vk.com/app51234567 (id приложения берётся из неё)
VK_MINI_APP_URL=
# VK_APP_ID=
# longpoll (по умолчанию, публичный адрес не нужен) | callback (нужен HTTPS-адрес /api/vk/callback)
VK_BOT_MODE=longpoll
# Защищённый ключ мини-приложения: проверка подписи X-VK-Launch-Params (доверять vk_user_id только с ней)
VK_APP_SECRET=
# Только для VK_BOT_MODE=callback: строка подтверждения и секретный ключ из настроек Callback API
VK_CONFIRMATION_CODE=
VK_SECRET=

# Версия текста согласия на обработку ПДн, сохраняется в анкете
CONSENT_VERSION=2026-10

# --- Вход HR и Режима жюри (POST /api/auth/login) ---
# Корпоративный ключ доступа HR. Для демо на хакатоне: Ochakovo#HR525!
HR_ACCESS_KEY=Ochakovo#HR525!
# Секрет подписи токенов сессии HR (любая длинная случайная строка). Если пусто — выводится из HR_ACCESS_KEY
HR_TOKEN_SECRET=
# Срок жизни токена HR в секундах (12 часов)
HR_TOKEN_TTL=43200
# Старый PIN 1978 как запасной вход (0 — отключить)
HR_ALLOW_LEGACY_PIN=1
HR_ACCESS_PIN=1978
# VK ID администраторов через запятую: вход без ключа из мини-приложения
VK_ADMIN_IDS=

# --- Производительность (слабый сервер) ---
# Таймаут запросов к VK API в секундах (LLM ждёт LLM_TIMEOUT)
HTTP_TIMEOUT=4.0
# Сколько секунд кэшировать /api/hr/dashboard и /api/analytics/summary
DASHBOARD_CACHE_TTL=15
